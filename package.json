{
  "name": "digambaran",
  "version": "1.0.0",
  "description": "You can download anything... if Digambaran allows you.",
  "main": "dist/electron/main.js",
  "author": "Digambaran",
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "build:ts": "tsc",
    "build:renderer": "node scripts/copy-static.js",
    "build": "npm run icons && npm run build:ts && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.digambaran.app",
    "productName": "DIGAMBARAN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "chrome-extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "chrome-extension",
        "to": "chrome-extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DIGAMBARAN Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DIGAMBARAN",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  }
}
