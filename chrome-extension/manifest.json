{
  "manifest_version": 3,
  "name": "Digambaran",
  "version": "1.0.0",
  "description": "Connects Chrome downloads to the Digambaran desktop application.",
  "permissions": ["downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:17843/*"],
  "action": {
    "default_title": "Digambaran"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
